# URL configuration for Backend Services
NEXT_PUBLIC_BACKEND_HOST=

# URL configuration for License Plate Recognition
NEXT_PUBLIC_LPR_HOST=

# URL configuration for Parking Slot Occupancy
NEXT_PUBLIC_SLOT_HOST=

# Feature toggles (set by start.bat's feature menu). "false" disables the
# camera websocket for that feature; anything else (or unset) enables it.
NEXT_PUBLIC_ENABLE_LPR=
NEXT_PUBLIC_ENABLE_OCCUPANCY=